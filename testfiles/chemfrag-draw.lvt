% Smoke test: fragments inside \chemfig must typeset without errors.
\input{regression-test}
\documentclass{article}
\usepackage{chemfrag}
\begin{document}
\START
\newbox\testbox
\setbox\testbox\hbox{%
  \chemfig{!{benzene}-[::0]!{OH}}%
  \chemfig{!{benzene*}{2=NO_2,4=Cl}-[::0]!{OH}}%
  \chemfig{H_3C-!{benzene*}{exit=4}-[::0]!{COOH}}%
  \chemfig{!{chain}{6, 2=CH_3, 4=OH}-[::0]!{OH}}%
  \chemfig{!{pyridine*}{entry=3, circle}}%
  \chemfig{!{cyclohexane}-[::0]!{carboxyl}}%
  \chemfig{!{benzene*}{exit=3}-[::0]!{ester'}}%
  \chemfig{!{piperidine*}{1=, exit=1}-[::0]!{acetyl}}%
  \chemfig{!{naphthalene}}%
  \chemfig{!{ring*}{size=7, bonds={=-=-=--}, 3=Br}}%
  \chemfig{!{oleicacid}}\chemfig{!{arachidonicacid}}%
  \chemfig{!{peptide}{Phe-Tyr-Trp-His}}%
  \chemfig{H_3C-!{CH2n}{16}-COOH}\chemfig{!{alkyl}{16}-OH}%
  \chemfragpolymer{PVC}\chemfragpolymer{nylon66}\chemfragpolymer{PET}%
  \chemfragpolymer[n=500, delimiters=()]{CH_2-CH(-[6]F)}%
}
\TYPE{width>0: \ifdim\wd\testbox>0pt yes\else no\fi}
\END
