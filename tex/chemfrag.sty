%% README.md and CHANGELOG.md.
%%
%% chemfrag does not draw anything itself.  Every fragment is a chemfig
%% submolecule that turns into plain chemfig code, so fragments and
%% hand-written chemfig code can be mixed freely inside \chemfig{...}.
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage{chemfrag}{2026-11-25}{1.0.0}
  {Ready-made rings, chains and functional groups for chemfig}

\RequirePackage{chemfig}

%% chemfig 1.6 or later is needed (submolecules with arguments, \expanded).
\fp_compare:nNnT { \CFver } < { 1.6 }
  {
    \msg_new:nnn { chemfrag } { old-chemfig }
      { chemfrag~needs~chemfig~1.6~or~later;~you~have~\CFver. }
    \msg_error:nn { chemfrag } { old-chemfig }
  }

\tl_const:Nn \c_chemfrag_version_tl { 1.0.0 }
\NewExpandableDocumentCommand \chemfragversion { } { \c_chemfrag_version_tl }

\file_input:n { chemfrag-core.code.tex }
\file_input:n { chemfrag-rings.code.tex }
\file_input:n { chemfrag-chains.code.tex }

%% \chemfragset{<keys>}: defaults for every fragment (later calls win).
\NewDocumentCommand \chemfragset { m }
  { \tl_put_left:Nn \l__chemfrag_defaults_tl { #1 , } }

%% The groups are plain chemfig code: read them with document catcodes.
\ExplSyntaxOff
\input{chemfrag-groups.code.tex}
\ExplSyntaxOn
